# SecureFPS Environment Configuration Example
# Copy to .env and configure secrets before launching.

# Core Secrets (Must be changed in production; server will refuse to start with default values)
FLASK_SECRET_KEY=generate-a-strong-random-secret-key-min-32-chars
GAME_SERVER_SECRET=generate-a-strong-random-shared-game-server-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SetAStrongAdminPassword123!
ADMIN_MFA_SECRET=JBSWY3DPEHPK3PXP
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_MFA_SECRET=

# Server Settings
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
FLASK_DEBUG=0
APP_ENV=development
SECUREFPS_LOCAL_DEV=true
SECUREFPS_ENABLE_DEMO=0
DEMO_CHEATER_PASSWORD=SecureFPS@Demo2026!
DEMO_CHEATER_MFA_SECRET=LPXQVQ5B2ZYEPVJDOMCUJCAHF7IS3U6D

# Database
MONGO_URI=mongodb://127.0.0.1:27017/
DB_NAME=secure_fps
RATELIMIT_STORAGE_URI=memory://

# Security & CORS
FRONTEND_ORIGIN=http://127.0.0.1:5500
SESSION_COOKIE_SECURE=0
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=3600

# Gameplay ML Anti-Cheat
GAMEPLAY_REALTIME_ENABLED=1
GAMEPLAY_REALTIME_MIN_EVENTS=24
GAMEPLAY_REALTIME_WINDOW_EVENTS=100
GAMEPLAY_REALTIME_INTERVAL_SECONDS=5
BAN_RISK_THRESHOLD=85
DEMO_HACKER_BAN_RISK_THRESHOLD=85
GAMEPLAY_ALERT_MEDIUM_RISK=50
GAMEPLAY_ALERT_HIGH_RISK=75
